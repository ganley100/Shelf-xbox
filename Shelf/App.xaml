<Application x:Class="Shelf.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <SolidColorBrush x:Key="ShelfBackground" Color="#111111"/>
        <SolidColorBrush x:Key="ShelfAccent" Color="#F5B82E"/>
        <SolidColorBrush x:Key="ShelfMuted" Color="#9A9A9A"/>
        <SolidColorBrush x:Key="ShelfCard" Color="#222222"/>
    </Application.Resources>
</Application>
