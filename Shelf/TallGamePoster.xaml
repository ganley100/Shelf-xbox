<UserControl x:Class="Shelf.TallGamePoster"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <!-- A game as a cable-style 2:3 poster: the two teams' colours split on a slant, big logos, "AT" (or the league's
         logo, or the score) in the middle, the league across the top and the matchup across the bottom.
         Drawn at 400×600 and scaled to fill. -->
    <Viewbox Stretch="UniformToFill">
        <Grid Width="400" Height="600" Background="#101418">
            <Polygon x:Name="SideA" Points="0,0 400,0 400,250 0,350" Fill="#1F3B57"/>
            <Polygon x:Name="SideB" Points="0,350 400,250 400,600 0,600" Fill="#4D2424"/>
            <!-- Light from the top, shade at the bottom for the text -->
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#8C000000" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="0.16"/>
                        <GradientStop Color="#00000000" Offset="0.62"/>
                        <GradientStop Color="#F2000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#40000000" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="0.5"/>
                        <GradientStop Color="#40000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- The slanted divider -->
            <Polygon x:Name="Divider" Points="0,343 400,243 400,257 0,357" Fill="#F2FFFFFF"/>
            <!-- A show rather than a game (wrestling, NFL RedZone): its name, big -->
            <TextBlock x:Name="SoloText" FontSize="46" FontWeight="Black" Foreground="White" TextAlignment="Center" TextWrapping="Wrap" MaxLines="4"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="30,0,30,40"/>

            <!-- League, top left (the corner badges sit top right) -->
            <TextBlock x:Name="LeagueText" Margin="24,22,150,0" VerticalAlignment="Top" TextAlignment="Left" FontSize="20" FontWeight="Black"
                       CharacterSpacing="100" Foreground="White" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" LineHeight="23"/>

            <!-- Away team -->
            <Grid x:Name="LogoAGrid" Width="230" Height="170" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,80,0,0">
                <Image x:Name="LogoAImage" Stretch="Uniform"/>
                <TextBlock x:Name="NameAText" FontSize="40" FontWeight="Black" TextAlignment="Center" TextWrapping="Wrap" MaxLines="3"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="White"/>
            </Grid>

            <!-- AT / VS / the score -->
            <Border x:Name="Disc" Width="96" Height="96" CornerRadius="48" Background="#E6101418" BorderBrush="White" BorderThickness="5"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,252,0,0">
                <TextBlock x:Name="MiddleText" FontSize="30" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <!-- The league's logo in the middle (NFL shield, NBA…), on a white disc over the divider -->
            <Border x:Name="LeagueDisc" Width="124" Height="124" CornerRadius="62" Background="#F7FFFFFF" BorderBrush="White" BorderThickness="4"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,238,0,0" Visibility="Collapsed" Padding="16">
                <Image x:Name="LeagueImage" Stretch="Uniform"/>
            </Border>

            <!-- Home team -->
            <Grid Width="230" Height="136" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,368,0,0">
                <Image x:Name="LogoBImage" Stretch="Uniform"/>
                <TextBlock x:Name="NameBText" FontSize="40" FontWeight="Black" TextAlignment="Center" TextWrapping="Wrap" MaxLines="3"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="White"/>
            </Grid>

            <!-- Matchup and channel / time -->
            <StackPanel VerticalAlignment="Bottom" Margin="20,0,20,18">
                <TextBlock x:Name="TitleText" FontSize="27" FontWeight="Bold" Foreground="White" TextAlignment="Center" TextWrapping="Wrap"
                           MaxLines="2" TextTrimming="CharacterEllipsis" LineHeight="31"/>
                <TextBlock x:Name="FooterText" FontSize="19" FontWeight="SemiBold" Foreground="#F5B82E" TextAlignment="Center" CharacterSpacing="40"
                           TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
    </Viewbox>
</UserControl>
