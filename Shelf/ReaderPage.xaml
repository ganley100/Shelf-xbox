<Page x:Class="Shelf.ReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#111111">
    <Grid>
        <WebView x:Name="View" DefaultBackgroundColor="#111111" Margin="0,0,0,0"/>
        <Border Background="#AA000000" CornerRadius="6" Padding="14,6" Margin="48,0,48,27"
                HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <TextBlock x:Name="Counter" FontSize="18"/>
        </Border>
    </Grid>
</Page>
