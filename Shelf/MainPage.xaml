<Page x:Class="Shelf.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Shelf"
    Background="{StaticResource ShelfBackground}">

    <Page.Resources>
        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Background" Value="#262626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="40"/>
            <Setter Property="Padding" Value="40,16"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource ShelfAccent}"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="3"/>
            <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
        </Style>
    </Page.Resources>

    <Grid Padding="96,60,96,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Shelf / Your media library · N items          [Live TV] [+ Add media] -->
        <StackPanel>
            <TextBlock Text="Shelf" FontFamily="Georgia" FontSize="64" FontWeight="Bold"/>
            <TextBlock x:Name="Subtitle" Text="Your media library" FontSize="28" Foreground="{StaticResource ShelfMuted}" Margin="0,2,0,0"/>
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="24">
            <Button x:Name="LiveTvButton" Content="Live TV" Style="{StaticResource Pill}" Click="LiveTv_Click"/>
            <Button x:Name="SportsButton" Content="Sports" Style="{StaticResource Pill}" Click="Sports_Click"/>
            <Button x:Name="AddButton" Content="+  Add media" Style="{StaticResource Pill}" Click="Add_Click"/>
        </StackPanel>

        <!-- Category chips -->
        <ScrollViewer Grid.Row="1" Margin="0,36,0,0" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Chips" Orientation="Horizontal" Spacing="20" Padding="0,4"/>
        </ScrollViewer>

        <!-- What's highlighted: "Title · Super Nintendo · Game" -->
        <TextBlock x:Name="DetailLine" Grid.Row="2" FontSize="34" Margin="0,30,0,8" TextTrimming="CharacterEllipsis" MaxLines="1"/>

        <GridView x:Name="CoverGrid" Grid.Row="3" IsItemClickEnabled="True" ItemClick="CoverGrid_ItemClick" SelectionMode="None"
                  ContainerContentChanging="CoverGrid_ContainerContentChanging" GotFocus="CoverGrid_GotFocus" LostFocus="CoverGrid_LostFocus"
                  Padding="0,0,0,60" Margin="-16,0,-16,0">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="16,10"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="UseSystemFocusVisuals" Value="False"/>
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local:Item">
                    <!-- Every cover sits on the row's baseline, in its own shape (Kindle style). -->
                    <Grid Width="276" Height="340">
                        <Grid VerticalAlignment="Bottom" HorizontalAlignment="Center">
                            <!-- Real art -->
                            <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="Uniform" MaxWidth="268" MaxHeight="332"/>

                            <!-- Drawn book-style cover -->
                            <Grid Width="{x:Bind TileWidth}" Height="{x:Bind TileHeight}" Background="{x:Bind TileBrush}"
                                  Visibility="{x:Bind BookTileVisibility, Mode=OneWay}">
                                <Border BorderBrush="#66FFFFFF" BorderThickness="2" Margin="14"/>
                                <TextBlock Text="{x:Bind Title}" FontFamily="Georgia" FontSize="28" FontWeight="Bold" TextWrapping="Wrap"
                                           TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30"
                                           MaxLines="5" TextTrimming="CharacterEllipsis"/>
                            </Grid>

                            <!-- Drawn cartridge for games -->
                            <Grid Width="{x:Bind TileWidth}" Height="{x:Bind TileHeight}" Background="{x:Bind CartridgeColor}" CornerRadius="10"
                                  Visibility="{x:Bind CartridgeVisibility, Mode=OneWay}" Padding="22,26,22,26">
                                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Top" Margin="6,-14,0,0">
                                    <Rectangle Width="24" Height="5" Fill="#55000000"/><Rectangle Width="24" Height="5" Fill="#55000000"/>
                                    <Rectangle Width="24" Height="5" Fill="#55000000"/><Rectangle Width="24" Height="5" Fill="#55000000"/>
                                </StackPanel>
                                <Grid Background="#F2EFE6" CornerRadius="4">
                                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="{x:Bind Title}" Foreground="#222222" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"
                                               Margin="14,12" MaxLines="3" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Row="1" Background="{x:Bind SystemColor}" Padding="12,4">
                                        <TextBlock Text="{x:Bind SystemLabel}" Foreground="White" FontSize="13" FontWeight="Bold" CharacterSpacing="80"/>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- Corner badge -->
                            <Border Background="#E6111111" CornerRadius="16" Padding="12,4" Margin="0,10,10,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="{x:Bind BadgeText}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            </Border>

                            <!-- Gold outline on the highlighted cover -->
                            <Border BorderBrush="{StaticResource ShelfAccent}" BorderThickness="5" CornerRadius="8" Margin="-8"
                                    Visibility="{x:Bind FocusVisibility, Mode=OneWay}"/>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <TextBlock x:Name="Empty" Grid.Row="3" FontSize="26" TextWrapping="Wrap" Foreground="{StaticResource ShelfMuted}"
                   Visibility="Collapsed" Margin="0,24,0,0" MaxWidth="1300" HorizontalAlignment="Left"/>
    </Grid>
</Page>
