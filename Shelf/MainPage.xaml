<Page x:Class="Shelf.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Shelf"
    Background="{StaticResource ShelfBackground}">

    <Page.Resources>
        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Background" Value="#262626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="40"/>
            <Setter Property="Padding" Value="40,16"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource ShelfAccent}"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="3"/>
            <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
        </Style>
    </Page.Resources>

    <Grid Padding="96,60,96,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Shelf / Your media library · N items          [Live TV] [+ Add media] -->
        <StackPanel>
            <TextBlock Text="Shelf" FontFamily="Georgia" FontSize="64" FontWeight="Bold"/>
            <TextBlock x:Name="Subtitle" Text="Your media library" FontSize="28" Foreground="{StaticResource ShelfMuted}" Margin="0,2,0,0"/>
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="24">
            <Button x:Name="LiveTvButton" Content="Live TV" Style="{StaticResource Pill}" Click="LiveTv_Click"/>
            <Button x:Name="SportsButton" Content="Sports" Style="{StaticResource Pill}" Click="Sports_Click"/>
            <Button x:Name="AddButton" Content="+  Add media" Style="{StaticResource Pill}" Click="Add_Click"/>
        </StackPanel>

        <!-- Category chips -->
        <ScrollViewer Grid.Row="1" Margin="0,36,0,0" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Chips" Orientation="Horizontal" Spacing="20" Padding="0,4"/>
        </ScrollViewer>

        <!-- What's highlighted: "Title · Super Nintendo · Game" -->
        <TextBlock x:Name="DetailLine" Grid.Row="2" FontSize="34" Margin="0,30,0,8" TextTrimming="CharacterEllipsis" MaxLines="1"/>

        <GridView x:Name="CoverGrid" Grid.Row="3" IsItemClickEnabled="True" ItemClick="CoverGrid_ItemClick" SelectionMode="None"
                  ContainerContentChanging="CoverGrid_ContainerContentChanging" GotFocus="CoverGrid_GotFocus" LostFocus="CoverGrid_LostFocus"
                  Padding="0,0,0,60" Margin="-16,0,-16,0">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="14,12"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="UseSystemFocusVisuals" Value="False"/>
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local:Item">
                    <!-- Every item is a 2:3 portrait poster; its art fills the whole poster. -->
                    <Grid Width="214" Height="321" CornerRadius="6" Background="#1C1C1C">
                        <!-- Real art -->
                        <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill"/>

                        <!-- Drawn poster (books, videos, music… without art) -->
                        <Grid Background="{x:Bind TileBrush}" Visibility="{x:Bind BookTileVisibility, Mode=OneWay}">
                            <Border BorderBrush="#66FFFFFF" BorderThickness="2" Margin="12"/>
                            <TextBlock Text="{x:Bind Title}" FontFamily="Georgia" FontSize="26" FontWeight="Bold" TextWrapping="Wrap"
                                       TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="26"
                                       MaxLines="6" TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <!-- Recorded game: a matchup poster (league, team, AT, team) -->
                        <Grid Visibility="{x:Bind MatchupVisibility, Mode=OneWay}">
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#1E5631" Offset="0"/><GradientStop Color="#0B2414" Offset="1"/>
                                </LinearGradientBrush>
                            </Grid.Background>
                            <Rectangle Stroke="#22FFFFFF" StrokeThickness="2" Margin="8" RadiusX="3" RadiusY="3"/>
                            <Rectangle Height="2" Fill="#22FFFFFF" VerticalAlignment="Center" Margin="8,0"/>
                            <Ellipse Width="84" Height="84" Stroke="#22FFFFFF" StrokeThickness="2"/>
                            <Grid Margin="14,16,14,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{x:Bind LeagueUpper}" FontSize="13" FontWeight="Bold" Foreground="#CCFFFFFF" CharacterSpacing="60"
                                           TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,30,0,6"/>
                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <Image Source="{x:Bind LogoA, Mode=OneWay}" Height="78" Stretch="Uniform" Visibility="{x:Bind LogosVisibility, Mode=OneWay}"/>
                                    <TextBlock Text="{x:Bind Away}" FontSize="17" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Row="2" Text="{x:Bind SepUpper}" FontSize="16" FontWeight="Bold" Foreground="#CCFFFFFF" TextAlignment="Center" Margin="0,4"/>
                                <StackPanel Grid.Row="3" VerticalAlignment="Center">
                                    <Image Source="{x:Bind LogoB, Mode=OneWay}" Height="78" Stretch="Uniform" Visibility="{x:Bind LogosVisibility, Mode=OneWay}"/>
                                    <TextBlock Text="{x:Bind Home}" FontSize="17" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Game: a game-box poster with the system's band -->
                        <Grid Background="{x:Bind CartridgeColor}" Visibility="{x:Bind CartridgeVisibility, Mode=OneWay}">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Background="{x:Bind SystemColor}" Padding="12,10">
                                <TextBlock Text="{x:Bind SystemLabel}" Foreground="White" FontSize="14" FontWeight="Bold" CharacterSpacing="80" TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <Grid Grid.Row="1" Background="#F2EFE6" Margin="12" CornerRadius="4">
                                <TextBlock Text="{x:Bind Title}" Foreground="#222222" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"
                                           Margin="16" MaxLines="6" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" TextAlignment="Center"/>
                            </Grid>
                        </Grid>

                        <!-- Corner badge -->
                        <Border Background="#E6111111" CornerRadius="14" Padding="10,3" Margin="0,8,8,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="{x:Bind BadgeText}" FontSize="15" FontWeight="Bold" Foreground="White"/>
                        </Border>

                        <!-- Gold outline on the highlighted poster -->
                        <Border BorderBrush="{StaticResource ShelfAccent}" BorderThickness="5" CornerRadius="6"
                                Visibility="{x:Bind FocusVisibility, Mode=OneWay}"/>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <TextBlock x:Name="Empty" Grid.Row="3" FontSize="26" TextWrapping="Wrap" Foreground="{StaticResource ShelfMuted}"
                   Visibility="Collapsed" Margin="0,24,0,0" MaxWidth="1300" HorizontalAlignment="Left"/>
    </Grid>
</Page>
