<Page x:Class="Shelf.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Shelf"
    Background="{StaticResource ShelfBackground}">

    <Grid Padding="96,48,96,27">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical">
            <TextBlock Text="Shelf" FontFamily="Georgia" FontSize="56" FontWeight="Bold"/>
            <TextBlock Text="Your media library" FontSize="22" Foreground="{StaticResource ShelfMuted}"/>
        </StackPanel>
        <Button x:Name="LiveTvButton" Content="Live TV" Click="LiveTv_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                FontSize="22" FontWeight="SemiBold" Padding="28,12" CornerRadius="28"/>

        <ListView x:Name="Tabs" Grid.Row="1" Margin="0,24,0,0" SelectionMode="Single" IsItemClickEnabled="False"
                  SelectionChanged="Tabs_SelectionChanged" ScrollViewer.HorizontalScrollMode="Enabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollMode="Disabled"
                  XYFocusDownNavigationStrategy="NavigationDirectionDistance">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{x:Bind}" FontSize="22" Margin="12,4"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" Margin="0,12,0,12">
            <TextBlock x:Name="Status" FontSize="18" TextWrapping="Wrap" Foreground="{StaticResource ShelfMuted}"/>
            <Button x:Name="ChooseFolder" Content="Choose the Shelf folder (pick D: → DevelopmentFiles)" Click="ChooseFolder_Click"
                    FontSize="20" FontWeight="SemiBold" Padding="24,10" CornerRadius="24" Margin="0,12,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <GridView x:Name="Grid" Grid.Row="3" IsItemClickEnabled="True" ItemClick="Grid_ItemClick"
                  SelectionMode="None" ContainerContentChanging="Grid_ContainerContentChanging">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local:Item">
                    <Grid Width="200" Height="300" Background="{StaticResource ShelfCard}" CornerRadius="6">
                        <TextBlock Text="{x:Bind Initials}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Margin="16,40,16,16" MaxLines="5" TextTrimming="CharacterEllipsis"/>
                        <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="Uniform"/>
                        <Border Background="#CC000000" CornerRadius="4" Padding="8,3" Margin="8"
                                HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock Text="{x:Bind Badge}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource ShelfAccent}"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
