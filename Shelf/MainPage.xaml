<Page x:Class="Shelf.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Shelf"
    Background="#2A2A2C">

    <Page.Resources>
        <!-- A row in the sidebar: an icon and a name; the chosen one is white with dark text (Apple TV style). -->
        <Style x:Key="SideRow" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="30"/>
            <Setter Property="Padding" Value="26,12"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="3"/>
            <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
        </Style>
    </Page.Resources>

    <Grid Padding="64,48,72,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar: the library's name, its sections, Live TV and Sports, and genres -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <Border Background="#3A3A3C" CornerRadius="30" Padding="22,10" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE8F1;" FontSize="22"/>
                        <TextBlock Text="Chris Video Library" FontSize="24" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="Subtitle" FontSize="18" Foreground="{StaticResource ShelfMuted}" Margin="8,10,0,18" TextWrapping="Wrap"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Padding="0,0,24,40">
                <StackPanel x:Name="Side" Spacing="4"/>
            </ScrollViewer>
        </Grid>

        <!-- Posters, 6 to a row -->
        <Grid Grid.Column="1" Margin="24,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- What's highlighted: "Title · 2024 · Movie" -->
            <TextBlock x:Name="DetailLine" FontSize="24" Foreground="#BDBDBD" Margin="2,10,0,14" TextTrimming="CharacterEllipsis" MaxLines="1"/>

            <GridView x:Name="CoverGrid" Grid.Row="1" IsItemClickEnabled="True" ItemClick="CoverGrid_ItemClick" SelectionMode="None"
                      ContainerContentChanging="CoverGrid_ContainerContentChanging" GotFocus="CoverGrid_GotFocus" LostFocus="CoverGrid_LostFocus"
                      Padding="0,6,0,60" Margin="-14,0,-14,0">
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="15,15"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="UseSystemFocusVisuals" Value="False"/>
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:Item">
                        <!-- Every item is a 2:3 portrait poster with rounded corners, like the Apple TV app's library (drawn at
                             214x321 and shown at 200x300). -->
                        <Grid Width="200" Height="300" CornerRadius="14" Background="#3A3A3C">
                        <Viewbox Stretch="Fill">
                        <Grid Width="214" Height="321">
                            <!-- Real art: a poster fills the tile -->
                            <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" Visibility="{x:Bind CoverFillVisibility, Mode=OneWay}"/>
                            <!-- No real poster (a wide picture or a channel logo): made into one, the same size and style: the picture
                                 fills the tile, dimmed, with the title large in the middle and the channel at the bottom. -->
                            <Grid Visibility="{x:Bind CoverFitVisibility, Mode=OneWay}">
                                <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" Opacity="0.55"/>
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#99000000" Offset="0"/><GradientStop Color="#59000000" Offset="0.5"/><GradientStop Color="#E6000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Border BorderBrush="#4DFFFFFF" BorderThickness="2" Margin="12"/>
                                <TextBlock Text="{x:Bind FitTitle}" FontFamily="Georgia" FontSize="27" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"
                                           MaxLines="5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="24,0,24,30"/>
                                <TextBlock Text="{x:Bind FitChannel}" FontSize="14" FontWeight="Bold" CharacterSpacing="80" Foreground="#F5B82E" TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" Margin="20,0,20,26"/>
                            </Grid>

                            <!-- Drawn poster (books, videos, music… without art) -->
                            <Grid Background="{x:Bind TileBrush}" Visibility="{x:Bind BookTileVisibility, Mode=OneWay}">
                                <Border BorderBrush="#66FFFFFF" BorderThickness="2" Margin="12"/>
                                <TextBlock Text="{x:Bind Title}" FontFamily="Georgia" FontSize="26" FontWeight="Bold" TextWrapping="Wrap"
                                           TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="26"
                                           MaxLines="6" TextTrimming="CharacterEllipsis"/>
                            </Grid>

                            <!-- Recorded game: a cable-style poster in the teams' colours (league, logos, AT) -->
                            <local:TallGamePoster Visibility="{x:Bind MatchupVisibility, Mode=OneWay}" ShowLeague="{x:Bind LeagueStyle}" League="{x:Bind LeagueUpper}" TeamA="{x:Bind Away}" TeamB="{x:Bind Home}"
                                              Middle="{x:Bind SepUpper}" LogoA="{x:Bind LogoA, Mode=OneWay}" LogoB="{x:Bind LogoB, Mode=OneWay}" Footer="{x:Bind PosterFooter}"/>

                            <!-- Game: a game-box poster with the system's band -->
                            <Grid Background="{x:Bind CartridgeColor}" Visibility="{x:Bind CartridgeVisibility, Mode=OneWay}">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Border Background="{x:Bind SystemColor}" Padding="12,10">
                                    <TextBlock Text="{x:Bind SystemLabel}" Foreground="White" FontSize="14" FontWeight="Bold" CharacterSpacing="80" TextTrimming="CharacterEllipsis"/>
                                </Border>
                                <Grid Grid.Row="1" Background="#F2EFE6" Margin="12" CornerRadius="4">
                                    <TextBlock Text="{x:Bind Title}" Foreground="#222222" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"
                                               Margin="16" MaxLines="6" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" TextAlignment="Center"/>
                                </Grid>
                            </Grid>

                        </Grid>
                        </Viewbox>
                        <!-- The highlighted poster: a white edge (it also grows a little) -->
                        <Border BorderBrush="White" BorderThickness="4" CornerRadius="14" Visibility="{x:Bind FocusVisibility, Mode=OneWay}"/>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <TextBlock x:Name="Empty" Grid.Row="1" FontSize="26" TextWrapping="Wrap" Foreground="{StaticResource ShelfMuted}"
                       Visibility="Collapsed" Margin="0,24,0,0" MaxWidth="1100" HorizontalAlignment="Left"/>
        </Grid>
    </Grid>
</Page>
