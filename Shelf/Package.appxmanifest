<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap mp rescap">

  <Identity Name="Shelf.MediaLibrary" Publisher="CN=Shelf" Version="0.1.0.0" />
  <mp:PhoneIdentity PhoneProductId="6f1c3f0e-9b0a-4c55-8a51-5d2a4b7e3c11" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>Chris Video Library</DisplayName>
    <PublisherDisplayName>Shelf</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Xbox" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="Shelf.App">
      <uap:VisualElements DisplayName="Chris Video Library" Description="Movies, TV shows, recordings and Live TV"
        BackgroundColor="#111111" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="Chris Video Library"/>
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#111111"/>
      </uap:VisualElements>
      <!-- Video files on USB drives (Import from USB) -->
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="videos">
            <uap:DisplayName>Videos</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.mp4</uap:FileType><uap:FileType>.m4v</uap:FileType><uap:FileType>.mkv</uap:FileType>
              <uap:FileType>.ts</uap:FileType><uap:FileType>.m2ts</uap:FileType><uap:FileType>.mov</uap:FileType>
              <uap:FileType>.avi</uap:FileType><uap:FileType>.wmv</uap:FileType><uap:FileType>.webm</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
    <uap:Capability Name="removableStorage" />
    <!-- D:\DevelopmentFiles on an Xbox in Developer Mode (and any folder on a PC). -->
    <rescap:Capability Name="broadFileSystemAccess" />
  </Capabilities>
</Package>
